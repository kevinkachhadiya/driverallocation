@{
    ViewData["Title"] = "Home Page";
}

<div class="container-fluid vh-100 d-flex flex-column p-3 bg-light text-center" id="fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap header-gradient p-3 rounded">
        <div class="d-flex align-items-center">
            <i class="bi bi-truck-front-fill text-white fs-2 me-3"></i>
            <h2 class="text-white fw-bold mb-0 fs-3"> Station Dashboard</h2>
        </div>
        <button class="btn btn-light btn-hover-scale btn-lg d-flex align-items-center shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#assignModal">
            <i class="bi bi-person-add me-2 fs-5 text-primary"></i>
            <span class="assign-text fw-medium">New Assignment</span>
        </button>
    </div>

    <!-- Drivers Section -->
    <div class="bg-white p-4 shadow-lg rounded-3 flex-grow-1">
        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-rolodex text-primary fs-3 me-3"></i>
                <h2 class="text-primary fw-semibold mb-0 fs-4">Active Drivers (24)</h2>
            </div>
            <div class="d-flex gap-2">
                <input type="text" class="form-control search-input" placeholder="Search drivers...">
                <div class="btn-group">
                    <button class="btn btn-outline-secondary btn-sm">All</button>
                    <button class="btn btn-outline-success btn-sm">Assigned</button>
                    <button class="btn btn-outline-danger btn-sm">Not Assigned</button>
                </div>
            </div>
        </div>

        <div class="row g-4">
            @for (int i = 1; i <= 12; i++)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="driver-card card h-100 shadow-sm hover-shadow transition-all">
                        <div class="card-body p-3">
                            <div class="avatar-status position-relative mb-3">
                                <div class="avatar bg-gradient-@(i%2 == 0 ? "success" : "secondary") text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                                     style="width: 60px; height: 60px;">
                                    <span class="fs-4">D@(i)</span>
                                </div>
                                <span class="status-dot bg-@(i%2 == 0 ? "success" : "danger")"></span>
                            </div>
                            <h5 class="mb-1 fw-semibold">Driver @i</h5>
                            <small class="text-muted d-block mb-2">Vehicle: TR@(1000 + i)</small>
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-sm btn-outline-primary btn-hover-scale">
                                    <i class="bi bi-chat-dots"></i>
                                </button>
                                <button class="btn btn-sm btn-gradient text-white btn-hover-scale"
                                        data-bs-toggle="modal"
                                        data-bs-target="#assignModal">
                                    Assign
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Enhanced Modal -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-gradient text-white">
                <h5 class="modal-title"><i class="bi bi-person-check me-2"></i>Assign Driver</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Select Driver</label>
                        <select class="form-select">
                            <option>Driver 1 - Available</option>
                            <option>Driver 2 - On Route</option>
                            <option>Driver 3 - Available</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vehicle Number</label>
                        <input type="text" class="form-control" placeholder="Enter vehicle number">
                    </div>
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-gradient text-white btn-hover-scale">
                            Confirm Assignment
                        </button>
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .header-gradient {
        background: linear-gradient(135deg, #3a7bd5, #00d2ff);
    }

    .btn-gradient {
        background: linear-gradient(45deg, #4b6cb7, #182848);
        border: none;
    }

    .driver-card {
        transition: transform 0.2s, box-shadow 0.2s;
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.075);
    }

        .driver-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }

    .status-dot {
        position: absolute;
        bottom: 5px;
        right: 5px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        border: 2px solid white;
    }

    .avatar {
        transition: transform 0.2s;
    }

    .btn-hover-scale:hover {
        transform: scale(1.05);
    }

    .search-input {
        max-width: 200px;
        transition: all 0.3s;
    }

        .search-input:focus {
            max-width: 300px;
        }

    .hover-shadow:hover {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    #fluid
    {
      margin-bottom:8rem;
    }
</style>
